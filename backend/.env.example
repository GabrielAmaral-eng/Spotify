PORT=3000

# Supabase Auth + Data API
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Apenas no backend. Nunca exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Spotify OAuth + Client Credentials. Nunca exponha segredos no frontend.
SPOTIFY_CLIENT_ID="seu_client_id"
SPOTIFY_CLIENT_SECRET="seu_client_secret"
SPOTIFY_REDIRECT_URI="http://127.0.0.1:3000/spotify/auth/callback"
SPOTIFY_OAUTH_STATE_SECRET="gere-uma-chave-longa-e-aleatoria"
SPOTIFY_TOKEN_ENCRYPTION_KEY="gere-outra-chave-longa-e-aleatoria"

# Frontend URL usada no CORS
FRONTEND_URL="http://localhost:8100"
