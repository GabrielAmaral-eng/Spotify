# Backend
# Use a Supabase Postgres connection string here. For a persistent Express server,
# prefer the Supavisor Session pooler URL on port 5432.
DATABASE_URL="postgres://prisma.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"
JWT_SECRET="troque_por_uma_chave_muito_longa_e_aleatoria"
PORT=3000

# Spotify Client Credentials. Nunca exponha no frontend.
SPOTIFY_CLIENT_ID="seu_client_id"
SPOTIFY_CLIENT_SECRET="seu_client_secret"

# Frontend URL usada no CORS
FRONTEND_URL="http://localhost:8100"
