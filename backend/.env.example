PORT=3000

# Supabase Auth + Data API
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Apenas no backend. Nunca exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Audius — API publica de musica. Nao exige chave nem segredo; apenas um
# nome de app para identificar as requisicoes.
AUDIUS_APP_NAME="Melodix"

# Frontend URL usada no CORS
FRONTEND_URL="http://localhost:8100"
