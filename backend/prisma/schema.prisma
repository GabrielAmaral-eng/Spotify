generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id        String     @id @default(uuid())
  token     String     @unique
  playlists Playlist[]
  favorites Favorite[]
  createdAt DateTime   @default(now())
}

model Playlist {
  id          String          @id @default(uuid())
  name        String
  description String?
  cover       String?
  sessionId   String
  session     Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tracks      PlaylistTrack[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([sessionId])
}

model PlaylistTrack {
  id         String   @id @default(uuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  trackId    String
  title      String
  artist     String
  album      String
  thumbnail  String
  duration   Int
  previewUrl String?
  order      Int
  addedAt    DateTime @default(now())

  @@unique([playlistId, trackId])
  @@index([playlistId])
}

model Favorite {
  id         String   @id @default(uuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  trackId    String
  title      String
  artist     String
  album      String
  thumbnail  String
  duration   Int
  previewUrl String?
  createdAt  DateTime @default(now())

  @@unique([sessionId, trackId])
  @@index([sessionId])
}
